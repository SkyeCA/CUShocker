<MudGrid Spacing="2" Class="mt-1">
	<MudItem xs="12" sm="4">
		<MudNumericField T="float" @bind-Value="Mode.StartsAtPain" @bind-Value:after="OnChanged"
						 Label="Starts at pain" Min="0" Step="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
	</MudItem>
	<MudItem xs="6" sm="4">
		<MudNumericField T="int" @bind-Value="Mode.MinIntensity" @bind-Value:after="OnChanged"
						 Label="Min intensity %" Min="PainRules.MinIntensity" Max="PainRules.MaxIntensity" Variant="Variant.Outlined" Margin="Margin.Dense" />
	</MudItem>
	<MudItem xs="6" sm="4">
		<MudNumericField T="int" @bind-Value="Mode.MaxIntensity" @bind-Value:after="OnChanged"
						 Label="Max intensity %" Min="PainRules.MinIntensity" Max="PainRules.MaxIntensity" Variant="Variant.Outlined" Margin="Margin.Dense" />
	</MudItem>
	<MudItem xs="12" sm="4" />
	<MudItem xs="6" sm="4">
		<MudNumericField T="int" @bind-Value="Mode.MinDurationMs" @bind-Value:after="OnChanged"
						 Label="Min duration (ms)" Min="PainRules.MinDurationMs" Max="PainRules.MaxDurationMs" Step="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
	</MudItem>
	<MudItem xs="6" sm="4">
		<MudNumericField T="int" @bind-Value="Mode.MaxDurationMs" @bind-Value:after="OnChanged"
						 Label="Max duration (ms)" Min="PainRules.MinDurationMs" Max="PainRules.MaxDurationMs" Step="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
	</MudItem>
</MudGrid>

@code {
	[Parameter, EditorRequired] public ModeConfig Mode { get; set; } = null!;
	[Parameter] public EventCallback Changed { get; set; }

	private Task OnChanged() => Changed.InvokeAsync();
}
